<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The app's look: panes side by side on a dark background, the way a tiling desktop and
         programs like btop or lazygit draw them. The colours here are the "white" scheme; the
         brushes are changed in place by App.ApplyColours when others are chosen in the menu, so
         everything that uses them follows at once. -->

    <!-- the type: one a terminal would use, the same on every system because the app brings it -->
    <FontFamily x:Key="ContentControlThemeFontFamily">/Assets/Fonts#JetBrains Mono NL, Cascadia Mono, Consolas, DejaVu Sans Mono, monospace, $Default</FontFamily>

    <!-- square corners throughout, the Fluent controls' too -->
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="SliderThumbCornerRadius">0</CornerRadius>
    <x:Double x:Key="SliderHorizontalThumbWidth">9</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>

    <SolidColorBrush x:Key="BgBrush" Color="#0B0B0C" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#151517" />
    <SolidColorBrush x:Key="Surface2HoverBrush" Color="#29292B" />
    <SolidColorBrush x:Key="Surface2PressedBrush" Color="#39393B" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#909096" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0B0C" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#5FD38D" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6E6E" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FFB000" />
    <!-- on a group's mark, which has the same colours whatever the scheme -->
    <SolidColorBrush x:Key="ChipTextBrush" Color="#0B0B0C" />

    <!-- full on the pane in use, mid on the others, dim on what is inside a pane -->
    <SolidColorBrush x:Key="LineBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineMidBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="LineDimBrush" Color="#47FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D9D9D9" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#24FFFFFF" />

    <!-- the Fluent theme's controls, in the same colours -->
    <StaticResource x:Key="TitleBarBackgroundBrush" ResourceKey="BgBrush" />
    <StaticResource x:Key="CaptionButtonForeground" ResourceKey="TextBrush" />
    <StaticResource x:Key="CaptionButtonBorderBrush" ResourceKey="LineDimBrush" />

    <StaticResource x:Key="SliderTrackFill" ResourceKey="LineDimBrush" />
    <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="LineDimBrush" />
    <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="LineDimBrush" />
    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderThumbBackground" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="AccentBrush" />
    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="AccentPressedBrush" />
    <StaticResource x:Key="SliderTickBarFill" ResourceKey="LineDimBrush" />

    <StaticResource x:Key="ComboBoxBackground" ResourceKey="BgBrush" />
    <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="Surface2HoverBrush" />
    <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="Surface2PressedBrush" />
    <StaticResource x:Key="ComboBoxBackgroundFocused" ResourceKey="BgBrush" />
    <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="BgBrush" />
    <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="LineDimBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="LineBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="LineBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushFocused" ResourceKey="LineBrush" />
    <StaticResource x:Key="ComboBoxBorderBrushUnfocused" ResourceKey="LineDimBrush" />
    <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="BgBrush" />
    <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="LineBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="Surface2HoverBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="Surface2PressedBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="SelectionBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="SelectionBrush" />
    <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="SelectionBrush" />
    <StaticResource x:Key="ComboBoxItemPillFillBrush" ResourceKey="AccentBrush" />

    <StaticResource x:Key="TextControlBackground" ResourceKey="BgBrush" />
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="Surface2HoverBrush" />
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="BgBrush" />
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="LineDimBrush" />
    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="LineBrush" />
    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="LineBrush" />
    <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextBrush" />

    <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentHoverBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentPressedBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUnchecked" ResourceKey="LineBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" ResourceKey="LineBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="AccentBrush" />
    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="AccentHoverBrush" />
    <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="OnAccentBrush" />
    <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="OnAccentBrush" />
    <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="OnAccentBrush" />

    <StaticResource x:Key="RadioButtonOuterEllipseStroke" ResourceKey="LineBrush" />
    <StaticResource x:Key="RadioButtonOuterEllipseStrokePointerOver" ResourceKey="LineBrush" />
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStroke" ResourceKey="AccentBrush" />
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" ResourceKey="AccentHoverBrush" />
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFill" ResourceKey="AccentBrush" />
    <StaticResource x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" ResourceKey="AccentHoverBrush" />
    <StaticResource x:Key="RadioButtonCheckGlyphFill" ResourceKey="OnAccentBrush" />
    <StaticResource x:Key="RadioButtonCheckGlyphFillPointerOver" ResourceKey="OnAccentBrush" />

    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="BgBrush" />
    <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="LineBrush" />
    <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="Surface2HoverBrush" />
    <StaticResource x:Key="MenuFlyoutItemBackgroundPressed" ResourceKey="Surface2PressedBrush" />
    <StaticResource x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" ResourceKey="Surface2HoverBrush" />

    <!-- the logo as the window's header draws it: the 32-pixel design of build/MakeIcon.cs, which prints these -->
    <LinearGradientBrush x:Key="LogoTileBrush" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#2A2A30" />
        <GradientStop Offset="1" Color="#0A0A0C" />
    </LinearGradientBrush>
    <StreamGeometry x:Key="LogoArrowOut">M8,10.5 H24 M19.84,6.34 L24,10.5 L19.84,14.66</StreamGeometry>
    <StreamGeometry x:Key="LogoArrowBack">M24,21.5 H8 M12.16,17.34 L8,21.5 L12.16,25.66</StreamGeometry>

    <!-- the start screen's word, in the proportions of a terminal's cells: drawn, so that it has no seams at any scale -->
    <StreamGeometry x:Key="BannerWord">M0,0H30V11H0ZM40,0H70V11H40ZM80,0H95V11H80ZM115,0H125V11H115ZM130,0H140V11H130ZM160,0H170V11H160ZM175,0H210V11H175ZM215,0H245V11H215ZM255,0H295V11H255ZM0,11H10V22H0ZM35,11H45V22H35ZM65,11H75V22H65ZM80,11H100V22H80ZM115,11H125V22H115ZM130,11H140V22H130ZM160,11H170V22H160ZM175,11H185V22H175ZM215,11H225V22H215ZM240,11H250V22H240ZM270,11H280V22H270ZM0,22H10V33H0ZM35,22H45V33H35ZM65,22H75V33H65ZM80,22H90V33H80ZM95,22H105V33H95ZM115,22H125V33H115ZM130,22H140V33H130ZM160,22H170V33H160ZM175,22H200V33H175ZM215,22H245V33H215ZM270,22H280V33H270ZM0,33H10V44H0ZM35,33H45V44H35ZM65,33H75V44H65ZM80,33H90V44H80ZM100,33H110V44H100ZM115,33H125V44H115ZM135,33H145V44H135ZM155,33H165V44H155ZM175,33H185V44H175ZM215,33H225V44H215ZM240,33H250V44H240ZM270,33H280V44H270ZM5,44H35V55H5ZM40,44H70V55H40ZM80,44H90V55H80ZM105,44H125V55H105ZM140,44H160V55H140ZM175,44H210V55H175ZM215,44H225V55H215ZM240,44H250V55H240ZM270,44H280V55H270Z</StreamGeometry>

    <!-- small line icons -->
    <StreamGeometry x:Key="IconClose">M 1,1 L 11,11 M 11,1 L 1,11</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M 1,2.5 H 5 L 6.5,4.5 H 13 V 11.5 H 1 Z</StreamGeometry>
    <StreamGeometry x:Key="IconOpen">M 6,2 H 2 V 12 H 12 V 8 M 8.5,2 H 12 V 5.5 M 12,2 L 6.5,7.5</StreamGeometry>
    <StreamGeometry x:Key="IconSliders">M 1,3 H 13 M 1,7 H 13 M 1,11 H 13 M 4.5,1.5 V 4.5 M 9.5,5.5 V 8.5 M 6,9.5 V 12.5</StreamGeometry>
    <StreamGeometry x:Key="IconPlus">M 6,1 V 11 M 1,6 H 11</StreamGeometry>
    <StreamGeometry x:Key="IconWarning">M 7,1.5 L 13,12.5 H 1 Z M 7,5.6 V 8.6 M 7,10.4 V 10.5</StreamGeometry>

</ResourceDictionary>
