<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:FileConverter"
             xmlns:core="using:FileConverter.Core"
             x:Class="FileConverter.App"
             Name="{x:Static core:AppInfo.DisplayName}"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:IsEqualConverter x:Key="IsEqual" />
            <local:GroupToBrushConverter x:Key="GroupToBrush" />
            <local:LowerCaseConverter x:Key="LowerCase" />
            <local:ProgressTextConverter x:Key="ProgressText" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#FFFFFF" RegionColor="#0B0B0C" ErrorText="#FF6E6E" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
