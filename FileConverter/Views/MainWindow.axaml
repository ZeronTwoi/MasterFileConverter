<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileConverter.ViewModels"
        xmlns:settings="using:FileConverter.Core.Settings"
        xmlns:core="using:FileConverter.Core"
        x:Class="FileConverter.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static core:AppInfo.DisplayName}"
        Icon="/Assets/app.ico"
        Width="1100" Height="720" MinWidth="980" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">

        <!-- ═══ the title bar: the app's own on Windows, the desktop's on Linux (MainWindow.axaml.cs) ═══ -->
        <StackPanel x:Name="TitleBar" Grid.Row="0" Orientation="Horizontal" Height="32" Margin="10,0,0,0" Spacing="8"
                    IsHitTestVisible="False">
            <!-- the logo, drawn rather than loaded: the same shapes as the icon (build/MakeIcon.cs) -->
            <Border Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center" ClipToBounds="True"
                    Background="{StaticResource LogoTileBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Viewbox>
                    <Canvas Width="32" Height="32">
                        <Path Data="{StaticResource LogoArrowOut}" Stroke="White" StrokeThickness="3"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                        <Path Data="{StaticResource LogoArrowBack}" Stroke="White" StrokeThickness="3"
                              StrokeLineCap="Round" StrokeJoin="Round" Opacity="0.8" />
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock Text="{Binding Source={x:Static core:AppInfo.DisplayName}, Converter={StaticResource LowerCase}}"
                       FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="8,0,8,0">
        <!-- ═══ the question about new versions — put once, until it is answered ═══ -->
        <Border Classes="note" Margin="0,0,0,10" IsVisible="{Binding AskAboutUpdates}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" TextWrapping="Wrap" Text="Tell you here when a new version is out?" />
                    <TextBlock Classes="dim" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="With Yes, the app asks GitHub for the newest version's number once each time it starts — nothing about you or your files is sent, and nothing is downloaded or installed unless you then choose to update. With No, it never connects by itself and does not ask again." />
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Content="Yes" VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="64"
                        HorizontalContentAlignment="Center"
                        Command="{Binding AnswerUpdateQuestionCommand}" CommandParameter="yes" />
                <Button Grid.Column="2" Content="No" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="64" Height="32"
                        HorizontalContentAlignment="Center"
                        Command="{Binding AnswerUpdateQuestionCommand}" CommandParameter="no"
                        ToolTip.Tip="You can still switch it on later, in the menu (F9)." />
            </Grid>
        </Border>

        <!-- ═══ an update the user asked for: being fetched, ready to go in, or failed ═══ -->
        <Border Classes="note" Margin="0,0,0,10" IsVisible="{Binding UpdateBannerVisible}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="Bold" TextWrapping="Wrap" Text="{Binding UpdateTitle}" />
                    <TextBlock Classes="dim" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding UpdateDetail}"
                               IsVisible="{Binding UpdateDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Margin="0,8,0,2" Height="4"
                                 IsVisible="{Binding UpdateFetching}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Cancel" VerticalAlignment="Center" Margin="14,0,0,0"
                        Command="{Binding CancelUpdateCommand}" IsVisible="{Binding UpdateFetching}" />
                <Button Grid.Column="1" Classes="accent" Content="Restart and update" VerticalAlignment="Center" Margin="14,0,0,0"
                        Command="{Binding RestartForUpdateCommand}" IsVisible="{Binding UpdateReady}"
                        ToolTip.ShowOnDisabled="True"
                        ToolTip.Tip="Closes the app, installs the new version and starts it again. Not while files are being converted." />
                <Button Grid.Column="1" Content="Open the download page" VerticalAlignment="Center" Margin="14,0,0,0"
                        Command="{Binding OpenDownloadPageCommand}" IsVisible="{Binding UpdateFailed}" />
                <Button Grid.Column="2" Classes="icon" VerticalAlignment="Center" Margin="6,0,0,0"
                        Command="{Binding DismissUpdateCommand}" IsVisible="{Binding !UpdateFetching}"
                        ToolTip.Tip="Close this note. An update that was fetched is not installed."
                        AutomationProperties.Name="Close this note">
                    <Path Data="{StaticResource IconClose}" />
                </Button>
            </Grid>
        </Border>

        <!-- ═══ setup banner ═══ -->
        <Border Classes="note" Margin="0,0,0,10" IsVisible="{Binding SetupNeeded}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock FontWeight="Bold" TextWrapping="Wrap"
                               Text="One-time setup: download the conversion engines (FFmpeg for audio and video, 7-Zip for archives)" />
                    <TextBlock Classes="dim" FontSize="12" Margin="0,3,0,0" Text="{Binding SetupStatus}"
                               IsVisible="{Binding SetupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ProgressBar Value="{Binding SetupProgress}" Maximum="100" Margin="0,8,0,2" Height="4"
                                 IsVisible="{Binding SetupRunning}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Content="Set up engines" VerticalAlignment="Center" Margin="14,0,0,0"
                        Command="{Binding SetupToolsCommand}" IsEnabled="{Binding !SetupRunning}" />
            </Grid>
        </Border>
        </StackPanel>

        <!-- ═══ file list, with the format settings beside it when they are switched on ═══ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="8,8,8,0">
        <Panel Grid.Column="0" Classes="pane">
        <Border Classes="card">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- the start screen: what the app is and what to press -->
                <StackPanel Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasItems}">
                    <!-- its shadow a little down and to the right, as the big letters of a terminal banner have -->
                    <Panel HorizontalAlignment="Center" Width="299" Height="59">
                        <Path Data="{StaticResource BannerWord}" Fill="{DynamicResource LineDimBrush}" Margin="4,4,0,0" />
                        <Path Data="{StaticResource BannerWord}" Fill="{DynamicResource AccentBrush}" />
                    </Panel>
                    <TextBlock Text="drop files or folders anywhere" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,12" />
                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                        <Button Classes="key" Command="{Binding AddFilesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="keycap" Text="F2" />
                                <TextBlock Text="add files" />
                            </StackPanel>
                        </Button>
                        <Button Classes="key" Command="{Binding AddFolderCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="keycap" Text="F3" />
                                <TextBlock Text="add a folder" />
                            </StackPanel>
                        </Button>
                        <Button Classes="key" Click="OnOpenMenu" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Classes="keycap" Text="F9" />
                                <TextBlock Text="colours, AI agents, more" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Classes="hint" HorizontalAlignment="Center" Margin="0,16,0,0"
                               Text="images · audio · video · documents · sheets · slides · archives" />
                </StackPanel>

                <!-- the names of the columns: the same widths as a row below -->
                <Border Grid.Row="0" Classes="columns" Margin="0,9,0,0" IsVisible="{Binding HasItems}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" MinWidth="110" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="*" MinWidth="90" />
                            <ColumnDefinition Width="78" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="from" />
                        <TextBlock Grid.Column="1" Text="name" />
                        <TextBlock Grid.Column="2" Text="size" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" Text="to" />
                        <TextBlock Grid.Column="5" Text="status" Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- several rows at once: Shift-click for a range, Ctrl-click to add or take away one,
                     and either held down while dragging over rows (see MainWindow.axaml.cs) -->
                <ListBox x:Name="FileList" Grid.Row="1" Classes="files" ItemsSource="{Binding Items}" SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding SelectedItem}" IsVisible="{Binding HasItems}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" MinWidth="110" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" MinWidth="90" />
                                    <!-- fixed, so the columns line up whether or not a row has result buttons -->
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>

                                <!-- the format it is in -->
                                <TextBlock Grid.Column="0" Classes="dim" Text="{Binding Extension}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />

                                <!-- name, and its marks -->
                                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- in no group, but with what every file of its format gets: said plainly, in
                                         no group's colour; a click shows those settings -->
                                    <Border DockPanel.Dock="Right" Classes="chip formatchip" Margin="6,0,0,0"
                                            BorderBrush="{DynamicResource LineDimBrush}" BorderThickness="1"
                                            IsVisible="{Binding HasFormatMark}" ToolTip.Tip="{Binding FormatTip}"
                                            AutomationProperties.Name="{Binding FormatTip}">
                                        <TextBlock Classes="dim" Text="{Binding FormatMarkText}" FontSize="10.5" />
                                    </Border>
                                    <!-- its group: one colour for every file given the same settings of its own;
                                         a click selects them all (MainWindow.axaml.cs) -->
                                    <Border DockPanel.Dock="Right" Classes="chip groupchip" Margin="6,0,0,0"
                                            Background="{Binding Group, Converter={StaticResource GroupToBrush}}"
                                            IsVisible="{Binding HasGroup}" ToolTip.Tip="{Binding GroupTip}"
                                            AutomationProperties.Name="{Binding GroupTip}">
                                        <TextBlock Text="{Binding GroupText}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{StaticResource ChipTextBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourcePath}" />
                                </DockPanel>

                                <TextBlock Grid.Column="2" Classes="hint" Text="{Binding SizeText}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="6,0,8,0" />

                                <!-- → for a conversion; (!) for a file set to its own format, which is only compressed -->
                                <Panel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Classes="dim" Text="→" HorizontalAlignment="Left"
                                               IsVisible="{Binding !IsSameFormat}" />
                                    <Border Width="16" Height="16" BorderThickness="1"
                                            BorderBrush="{DynamicResource WarnBrush}" Background="Transparent"
                                            HorizontalAlignment="Left" IsVisible="{Binding IsSameFormat}"
                                            AutomationProperties.Name="Same format: only compressed"
                                            ToolTip.Tip="Same format as the file: it is not converted into anything else, only compressed. What changes is what the Result slider and its Format settings ask for — quality, file size, resolution and the like. If it cannot be made smaller, it is kept as it was.">
                                        <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Panel>

                                <!-- target format -->
                                <ComboBox Grid.Column="4" Width="88" HorizontalAlignment="Left"
                                          ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding SelectedTarget}" />

                                <!-- status, and progress while it is being converted -->
                                <DockPanel Grid.Column="5" VerticalAlignment="Center" Margin="12,0,8,0">
                                    <TextBlock DockPanel.Dock="Left" Classes="meter" Margin="0,0,8,0" IsVisible="{Binding IsConverting}"
                                               Text="{Binding Progress, Converter={StaticResource ProgressText}}" />
                                    <TextBlock Classes="status" Classes.converting="{Binding IsConverting}"
                                               Classes.done="{Binding IsDone}" Classes.failed="{Binding IsFailed}"
                                               Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip.Tip="{Binding StatusText}" />
                                </DockPanel>

                                <!-- result and row actions -->
                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button Classes="icon" IsVisible="{Binding HasResult}" ToolTip.Tip="Open the result"
                                            AutomationProperties.Name="Open the result"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenResultCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconOpen}" />
                                    </Button>
                                    <Button Classes="icon" IsVisible="{Binding HasResult}" ToolTip.Tip="Show the result in its folder"
                                            AutomationProperties.Name="Show the result in its folder"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowResultInFolderCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconFolder}" />
                                    </Button>
                                    <Button Classes="icon" ToolTip.Tip="Remove from the list"
                                            AutomationProperties.Name="Remove from the list"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveItemCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Data="{StaticResource IconClose}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- one target at once, for every file or for those selected; under the list, so that
                     rows do not move while a selection is dragged out -->
                <Border Grid.Row="2" Classes="selectionbar">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="ShowBulkTarget" />
                            <Binding Path="ShowSelectionTarget" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowBulkTarget}">
                            <TextBlock Classes="dim" Text="Set all to" VerticalAlignment="Center" />
                            <ComboBox Width="88" ItemsSource="{Binding BulkTargetChoices}" SelectedItem="{Binding BulkTarget}"
                                      PlaceholderText="format" AutomationProperties.Name="Set all to"
                                      ToolTip.Tip="Pick one target format for every compatible file at once." />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowSelectionTarget}">
                            <TextBlock Classes="dim" Text="{Binding SelectionText}" VerticalAlignment="Center" />
                            <ComboBox Width="88" ItemsSource="{Binding SelectionTargetChoices}" SelectedItem="{Binding SelectionTarget}"
                                      PlaceholderText="format" AutomationProperties.Name="Set the files selected to"
                                      ToolTip.Tip="Pick one target format for the files selected alone; the other files keep theirs. A format only some of them can become says how many can, and the rest keep the one they have." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border Classes="legend">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="title" Text="files" />
                <TextBlock Classes="dim" Text="{Binding Items.Count}" IsVisible="{Binding HasItems}" />
            </StackPanel>
        </Border>
        </Panel>

        <!-- the settings of the selected file's target format; clipped, so that in a short window
             it shrinks into its own space instead of reaching over the settings for all files.
             With no files there is nothing to set, and the start screen has the whole width. -->
        <Panel Grid.Column="1" Classes="pane" Width="392" Margin="8,0,0,0">
        <Panel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="DetailedSettingsOpen" />
                <Binding Path="HasItems" />
            </MultiBinding>
        </Panel.IsVisible>
        <Border x:Name="FormatSettingsPanel" Classes="card" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*,Auto" DataContext="{Binding Detail}" x:DataType="vm:DetailPanelViewModel">

                <TextBlock Classes="hint" Text="{Binding Subtitle}" Margin="12,14,12,6"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding HasContext}"
                           ToolTip.Tip="{Binding Subtitle}" />

                <TextBlock Grid.Row="1" Classes="dim" Text="{Binding EmptyText}" TextWrapping="Wrap" Margin="12,14,12,14"
                           IsVisible="{Binding !HasSettings}" />

                <ScrollViewer Grid.Row="1" IsVisible="{Binding HasSettings}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">

                        <!-- who the settings are for: the files selected, unless every file of the format is chosen -->
                        <RadioButton GroupName="DetailScope" Content="{Binding ScopeFileText}" IsChecked="{Binding OnlyThisFile}"
                                     ToolTip.Tip="Settings for the files selected alone: files given the same settings are shown as one group, in one colour. Anything left empty follows the settings of every file of this format." />
                        <RadioButton GroupName="DetailScope" Content="{Binding ScopeAllText}" IsChecked="{Binding ScopeIsAll}"
                                     ToolTip.Tip="Settings for every file converted to this format — the ones in the list and the ones added later. They are remembered for next time." />

                        <!-- which group the files selected are in: one to join, or none -->
                        <Grid ColumnDefinitions="*,208" Margin="0,10,0,0" IsVisible="{Binding ShowGroupChoice}"
                              Background="Transparent"
                              ToolTip.Tip="Put the files selected in a group — they get the settings its files have — or in none: they then have no settings of their own and convert like every file of this format.">
                            <TextBlock Text="Group" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding GroupChoices}"
                                      SelectedItem="{Binding SelectedGroup}" PlaceholderText="Not the same for all"
                                      AutomationProperties.Name="Group">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GroupChoice">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Border Width="10" Height="10" VerticalAlignment="Center"
                                                    Background="{Binding Number, Converter={StaticResource GroupToBrush}}"
                                                    IsVisible="{Binding IsGroup}" />
                                            <TextBlock Text="{Binding Label}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <TextBlock Classes="dim" Text="{Binding MergeNote}" TextWrapping="Wrap" FontSize="11.5" Margin="0,10,0,0"
                                   IsVisible="{Binding MergeNote, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <!-- presets -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0" IsVisible="{Binding HasPresets}">
                            <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Choose a preset…"
                                      ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                      ToolTip.Tip="A preset fills in a whole set of settings at once. Whatever it does not mention goes back to automatic.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PresetChoice">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1" Classes="icon" Margin="4,0,0,0"
                                    Command="{Binding DeletePresetCommand}" IsVisible="{Binding CanDeletePreset}"
                                    ToolTip.Tip="Delete this preset" AutomationProperties.Name="Delete this preset">
                                <Path Data="{StaticResource IconClose}" />
                            </Button>
                        </Grid>

                        <!-- "this is no longer a copy" -->
                        <Border Classes="note" Margin="0,12,0,0"
                                IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="11.5" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingGroupViewModel">
                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Classes="grouphead" Text="{Binding Name, Converter={StaticResource LowerCase}}" />
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.DataTemplates>
                                                <DataTemplate x:DataType="vm:TextSettingRow">
                                                    <Grid ColumnDefinitions="*,208" Margin="0,6,0,0" Background="Transparent"
                                                          ToolTip.Tip="{Binding Help}" IsVisible="{Binding IsShown}">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                   Margin="0,0,10,0" />
                                                        <TextBox Grid.Column="1" Classes.secret="{Binding IsSecret}"
                                                                 Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                                                 PlaceholderText="{Binding Watermark}" />
                                                    </Grid>
                                                </DataTemplate>
                                                <DataTemplate x:DataType="vm:ChoiceSettingRow">
                                                    <Grid ColumnDefinitions="*,208" Margin="0,6,0,0" Background="Transparent"
                                                          ToolTip.Tip="{Binding Help}" IsVisible="{Binding IsShown}">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                   Margin="0,0,10,0" />
                                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                                  ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                                  PlaceholderText="Not the same for all">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="settings:SettingChoice">
                                                                    <TextBlock Text="{Binding Label}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.DataTemplates>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{DynamicResource LineDimBrush}" BorderThickness="0,1,0,0" Padding="12,8"
                        IsVisible="{Binding HasSettings}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Text="{Binding NewPresetName}" PlaceholderText="Save as preset…"
                                 ToolTip.Tip="Type a name and press Save to keep the settings in force for this file as a preset of your own. Passwords are never included." />
                        <Button Grid.Column="1" Content="Save" Margin="6,0,0,0" Height="26"
                                Command="{Binding SavePresetCommand}" />
                        <Button Grid.Column="2" Content="Reset" Margin="6,0,0,0" Height="26"
                                Command="{Binding ResetCommand}"
                                ToolTip.Tip="Put every setting shown here back to automatic." />
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Border Classes="legend" MaxWidth="340">
            <TextBlock Classes="title" Text="{Binding Detail.Title, Converter={StaticResource LowerCase}}" />
        </Border>
        </Panel>
        </Grid>

        <!-- ═══ combine banner — shown when several files share a combinable target ═══ -->
        <Border Grid.Row="3" Classes="note" Margin="8,8,8,0" IsVisible="{Binding HasMergeableGroups}">
            <Grid ColumnDefinitions="Auto,*">
                <CheckBox Content="Combine into one file" FontWeight="Bold" VerticalAlignment="Center"
                          IsChecked="{Binding CombineFiles}"
                          ToolTip.Tip="Files with the same target merge into a single output — e.g. 20 images become one multi-page PDF. Pages follow the file-name order (1, 2, 3…). Untick to convert every file separately." />
                <TextBlock Grid.Column="1" Classes="dim" Text="{Binding MergeHint}" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MergeHint}" />
            </Grid>
        </Border>

        <!-- ═══ settings for all files: what every conversion goes by, whatever its format ═══ -->
        <Panel Grid.Row="4" Classes="pane" Margin="8,16,8,0">
        <Border x:Name="AllFilesSettings" Classes="card" Padding="12,12,12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2.6*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- result: how small files are made and how fast, in one control; the graphics card and Auto folded away below -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <StackPanel ToolTip.Tip="How far each file is taken. To the left: smaller files, done sooner, at a lower quality. To the right: the quality the format can keep; at Best it also takes the time to make the file as small as it can be at that quality. A format can be given its own exact quality or size under Format settings instead.">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="label" Text="result" />
                            <TextBlock Grid.Column="1" Text="{Binding ResultText}" Margin="12,0,0,0" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ResultText}" />
                        </Grid>
                        <!-- the slider runs from the middle of the first name to the middle of the last -->
                        <Grid ColumnDefinitions="1*,8*,1*">
                            <Slider Grid.Column="1" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding ResultLevel}" Margin="0,-4,0,-6"
                                    AutomationProperties.Name="Result: from smallest to best" />
                        </Grid>
                        <UniformGrid x:Name="ResultStops" Rows="1" Columns="5">
                            <Button Classes="stop" Content="smallest" Command="{Binding SetResultCommand}" CommandParameter="0"
                                    Classes.on="{Binding ResultLevel, Converter={StaticResource IsEqual}, ConverterParameter=0}" />
                            <Button Classes="stop" Content="small" Command="{Binding SetResultCommand}" CommandParameter="1"
                                    Classes.on="{Binding ResultLevel, Converter={StaticResource IsEqual}, ConverterParameter=1}" />
                            <Button Classes="stop" Content="good" Command="{Binding SetResultCommand}" CommandParameter="2"
                                    Classes.on="{Binding ResultLevel, Converter={StaticResource IsEqual}, ConverterParameter=2}" />
                            <Button Classes="stop" Content="full" Command="{Binding SetResultCommand}" CommandParameter="3"
                                    Classes.on="{Binding ResultLevel, Converter={StaticResource IsEqual}, ConverterParameter=3}" />
                            <Button Classes="stop" Content="best" Command="{Binding SetResultCommand}" CommandParameter="4"
                                    Classes.on="{Binding ResultLevel, Converter={StaticResource IsEqual}, ConverterParameter=4}" />
                        </UniformGrid>
                    </StackPanel>
                    <!-- the formats whose size and quality are set in Format settings, so this slider does not decide them -->
                    <TextBlock Classes="hint accent" Margin="0,2,0,0"
                               Text="{Binding SliderExceptionText}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding SliderExceptionText}"
                               IsVisible="{Binding SliderExceptionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- for those who want the engines' own terms: closed until asked for -->
                    <ToggleButton x:Name="SpeedDetails" Classes="fold" Margin="-6,2,0,0" Padding="6,2" Height="22"
                                  HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                                  ToolTip.Tip="Choosing the speed for this PC, and the graphics card.">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Panel Width="8" Height="8" VerticalAlignment="Center">
                                <Path Data="M 2,0 L 6,4 L 2,8" Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.2"
                                      IsVisible="{Binding !#SpeedDetails.IsChecked}" />
                                <Path Data="M 0,2 L 4,6 L 8,2" Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.2"
                                      IsVisible="{Binding #SpeedDetails.IsChecked}" />
                            </Panel>
                            <TextBlock Classes="hint" Text="speed details" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel IsVisible="{Binding #SpeedDetails.IsChecked}" Margin="0,2,0,0">
                        <WrapPanel>
                            <CheckBox Content="Auto speed" Margin="0,0,14,0" IsChecked="{Binding AutoSpeed}"
                                      ToolTip.Tip="Pick the encoding speed that suits this PC's processor and graphics card, and leave only the size to the Result slider. Nothing leaves the machine. Moving the slider picks the speed by hand again." />
                            <CheckBox Content="Use GPU" IsChecked="{Binding UseGpu}" IsEnabled="{Binding GpuAvailable}"
                                      ToolTip.ShowOnDisabled="True"
                                      ToolTip.Tip="Encode video on the graphics card whenever that is clearly faster than this PC's processor (measured once, see the status line). At full quality this only makes files a little larger, not worse. &quot;Best&quot; always uses the CPU encoder, which compresses hardest." />
                        </WrapPanel>
                        <TextBlock Classes="hint" Text="{Binding EffectiveSpeedText}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" IsVisible="{Binding AutoSpeed}"
                                   ToolTip.Tip="{Binding EffectiveSpeedText}" />
                    </StackPanel>
                </StackPanel>

                <!-- where results go: a label's width on the left, as in a form -->
                <Grid Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,8,Auto">
                    <TextBlock Classes="label" Text="save to" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <DockPanel Grid.Column="1">
                        <Button DockPanel.Dock="Right" Classes="icon" Margin="2,0,0,0" Command="{Binding ResetOutputCommand}"
                                IsVisible="{Binding HasCustomOutputDirectory}"
                                ToolTip.Tip="Go back to saving each result next to its source file."
                                AutomationProperties.Name="Save next to each source file">
                            <Path Data="{StaticResource IconClose}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Content="change" Margin="8,0,0,0" Height="26" Command="{Binding ChooseOutputCommand}" />
                        <TextBlock Text="{Binding OutputDirectoryText}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OutputDirectoryText}" />
                    </DockPanel>
                    <TextBlock Grid.Row="2" Classes="label" Text="if exists" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Width="128" HorizontalAlignment="Left"
                              ItemsSource="{Binding ExistingFileOptions}" SelectedIndex="{Binding ExistingFileIndex}"
                              AutomationProperties.Name="If the file exists"
                              ToolTip.Tip="What happens when a result would get a name that is already taken in the target folder. Keep both adds a number (photo (1).jpg); Replace overwrites the old result; Skip leaves that file unconverted. The source file itself is never replaced." />
                </Grid>

                <!-- convert -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="150">
                    <Button Classes="accent" Content="{Binding ConvertButtonText, Converter={StaticResource LowerCase}}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding ConvertAllCommand}" IsVisible="{Binding !IsConverting}"
                            AutomationProperties.Name="{Binding ConvertButtonText}" />
                    <Button Content="cancel" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="32"
                            Command="{Binding CancelAllCommand}" IsVisible="{Binding IsConverting}"
                            AutomationProperties.Name="Cancel" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Classes="legend">
            <TextBlock Classes="title" Text="settings for all files"
                       ToolTip.Tip="Used for every file in the list, whatever its format. What only some formats have — resolution, codec, pages, password — is under Format settings (F6)." />
        </Border>
        </Panel>

        <!-- ═══ the status line: what the app is doing, what it says, and what it has to work with ═══ -->
        <Grid Grid.Row="5" Classes="statusline" Margin="0,8,0,0" Height="22" ColumnDefinitions="Auto,Auto,*,Auto">
            <Border Classes="mode">
                <Panel>
                    <TextBlock Text="READY" IsVisible="{Binding !IsConverting}" />
                    <TextBlock Text="CONVERTING" IsVisible="{Binding IsConverting}" />
                </Panel>
            </Border>
            <Path Grid.Column="1" Classes="modetip" Data="M 0,0 L 9,11 L 0,22 Z" />
            <DockPanel Grid.Column="2" Margin="8,0,12,0" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Classes="meter" Margin="0,0,10,0" IsVisible="{Binding IsConverting}"
                           Text="{Binding OverallProgress, Converter={StaticResource ProgressText}, ConverterParameter=16}" />
                <TextBlock Text="{Binding OverallStatus}" FontSize="11.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OverallStatus}" />
            </DockPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,10,0">
                <Ellipse Classes="dot" Classes.on="{Binding FfmpegAvailable}" Classes.warn="{Binding !FfmpegComplete}" />
                <TextBlock Classes="engine" Text="ffmpeg" Background="Transparent" ToolTip.Tip="{Binding FfmpegStatusDetail}" />
                <Ellipse Classes="dot" Classes.on="{Binding GpuInUse}" />
                <TextBlock Classes="engine" Text="gpu" Background="Transparent" ToolTip.Tip="{Binding GpuStatusText}" />
                <Ellipse Classes="dot" Classes.on="{Binding SevenZipAvailable}" />
                <TextBlock Classes="engine" Text="7z" Background="Transparent"
                           ToolTip.Tip="7-Zip: needed to create .7z archives, and the fastest way to unpack them." />
                <Ellipse Classes="dot" Classes.on="{Binding OfficeEngineAvailable}" />
                <TextBlock Classes="engine" Text="office" Background="Transparent" ToolTip.Tip="{Binding OfficeEngineTip}" />
                <Ellipse Classes="dot" Classes.on="{Binding RarAvailable}" />
                <TextBlock Classes="engine" Text="rar" Background="Transparent"
                           ToolTip.Tip="RAR is proprietary: only RARLAB's own encoder (part of WinRAR, or the rar command on Linux) may create .rar files. Reading and converting FROM .rar always works." />
                <TextBlock Classes="engine" Text="{Binding VersionText}" Margin="4,0,0,0" />
                <!-- a newer version is out -->
                <Button Classes="icon" Width="22" Height="20" Padding="0" Margin="6,0,0,0" IsVisible="{Binding UpdateAvailable}"
                        Command="{Binding UpdateNowCommand}" ToolTip.Tip="{Binding UpdateText}"
                        AutomationProperties.Name="{Binding UpdateText}">
                    <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource WarnBrush}" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ the keys, each also a button ═══ -->
        <Grid Grid.Row="6" Margin="2,1,2,1" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal">
                <Button Classes="key" Command="{Binding AddFilesCommand}" AutomationProperties.Name="Add files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="keycap" Text="F2" />
                        <TextBlock Text="add files" />
                    </StackPanel>
                </Button>
                <Button Classes="key" Command="{Binding AddFolderCommand}" AutomationProperties.Name="Add folder"
                        ToolTip.Tip="Add every file in a folder, including its subfolders.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="keycap" Text="F3" />
                        <TextBlock Text="add folder" />
                    </StackPanel>
                </Button>
                <Button Classes="key" Command="{Binding ConvertAllCommand}" AutomationProperties.Name="Convert"
                        ToolTip.Tip="The same as the big button above.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="keycap" Text="F5" />
                        <TextBlock Text="convert" />
                    </StackPanel>
                </Button>
                <ToggleButton Classes="key" IsChecked="{Binding DetailedSettingsOpen}" IsEnabled="{Binding HasItems}"
                              AutomationProperties.Name="Format settings"
                              ToolTip.Tip="Settings that belong to one target format — resolution, codec, pages, password and more — and, if you want, an exact quality or size for that format instead of the Result slider. Kept for each format, e.g. for everything you turn into MP4.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="keycap" Text="F6" />
                        <TextBlock Text="format settings" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Name="ClearButton" Classes="key" IsEnabled="{Binding HasItems}" AutomationProperties.Name="Clear">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Classes="keycap" Text="F8" />
                        <TextBlock Text="clear" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedLeft">
                            <MenuItem Header="Remove finished files" Command="{Binding ClearFinishedCommand}"
                                      IsEnabled="{Binding HasFinishedItems}" />
                            <MenuItem Header="Remove all files" Command="{Binding ClearAllCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <Button x:Name="MenuButton" Grid.Column="1" Classes="key" AutomationProperties.Name="Menu"
                    ToolTip.Tip="Colours, AI agents, new versions, settings file and licences">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="keycap" Text="F9" />
                    <TextBlock Text="menu" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight">
                        <MenuItem Header="{Binding UpdateText}" Command="{Binding UpdateNowCommand}"
                                  IsVisible="{Binding UpdateAvailable}">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.4"
                                      StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="14" Height="14" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator IsVisible="{Binding UpdateAvailable}" />
                        <MenuItem Header="Colours">
                            <MenuItem ToggleType="Radio" GroupName="Colours" Command="{Binding SetColoursCommand}" CommandParameter="white"
                                      IsChecked="{Binding Colours, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=white}">
                                <MenuItem.Header><TextBlock Text="White" Foreground="#FFFFFF" /></MenuItem.Header>
                            </MenuItem>
                            <MenuItem ToggleType="Radio" GroupName="Colours" Command="{Binding SetColoursCommand}" CommandParameter="green"
                                      IsChecked="{Binding Colours, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=green}">
                                <MenuItem.Header><TextBlock Text="Green" Foreground="#5FF287" /></MenuItem.Header>
                            </MenuItem>
                            <MenuItem ToggleType="Radio" GroupName="Colours" Command="{Binding SetColoursCommand}" CommandParameter="amber"
                                      IsChecked="{Binding Colours, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=amber}">
                                <MenuItem.Header><TextBlock Text="Amber" Foreground="#FFB000" /></MenuItem.Header>
                            </MenuItem>
                            <MenuItem ToggleType="Radio" GroupName="Colours" Command="{Binding SetColoursCommand}" CommandParameter="tokyo-night"
                                      IsChecked="{Binding Colours, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=tokyo-night}">
                                <MenuItem.Header><TextBlock Text="Tokyo Night" Foreground="#7AA2F7" /></MenuItem.Header>
                            </MenuItem>
                            <MenuItem ToggleType="Radio" GroupName="Colours" Command="{Binding SetColoursCommand}" CommandParameter="catppuccin"
                                      IsChecked="{Binding Colours, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=catppuccin}">
                                <MenuItem.Header><TextBlock Text="Catppuccin" Foreground="#CBA6F7" /></MenuItem.Header>
                            </MenuItem>
                            <MenuItem ToggleType="Radio" GroupName="Colours" Command="{Binding SetColoursCommand}" CommandParameter="gruvbox"
                                      IsChecked="{Binding Colours, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=gruvbox}">
                                <MenuItem.Header><TextBlock Text="Gruvbox" Foreground="#FE8019" /></MenuItem.Header>
                            </MenuItem>
                            <MenuItem ToggleType="Radio" GroupName="Colours" Command="{Binding SetColoursCommand}" CommandParameter="nord"
                                      IsChecked="{Binding Colours, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=nord}">
                                <MenuItem.Header><TextBlock Text="Nord" Foreground="#88C0D0" /></MenuItem.Header>
                            </MenuItem>
                            <MenuItem ToggleType="Radio" GroupName="Colours" Command="{Binding SetColoursCommand}" CommandParameter="dracula"
                                      IsChecked="{Binding Colours, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=dracula}">
                                <MenuItem.Header><TextBlock Text="Dracula" Foreground="#BD93F9" /></MenuItem.Header>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="Copy AI agent setup" Command="{Binding CopyAgentSetupCommand}"
                                  ToolTip.Tip="Copies what an AI agent (an MCP client) needs to convert files through this app. Nothing is sent anywhere; see docs/agents.md." />
                        <Separator />
                        <MenuItem Header="Tell me about new versions" ToggleType="CheckBox"
                                  IsChecked="{Binding NotifyAboutUpdates, Mode=OneWay}"
                                  Command="{Binding ToggleUpdateNoticesCommand}"
                                  ToolTip.Tip="When ticked, the app asks GitHub for the newest version's number once each time it starts, and shows a warning sign in the status line when there is one. Nothing about you or your files is sent, and nothing is installed unless you click the sign. When not ticked, it never connects by itself." />
                        <MenuItem Header="Look for a new version now" Command="{Binding LookForUpdateNowCommand}"
                                  ToolTip.Tip="One look, now: asks GitHub for the newest version's number." />
                        <Separator />
                        <MenuItem Header="Open the settings folder" Command="{Binding OpenSettingsFolderCommand}" />
                        <MenuItem Header="Licences" Command="{Binding OpenLicencesCommand}" />
                        <MenuItem Header="Website and source code" Command="{Binding OpenWebsiteCommand}"
                                  ToolTip.Tip="{x:Static core:AppInfo.Website}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</Window>
