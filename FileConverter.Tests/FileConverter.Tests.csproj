<Project Sdk="Microsoft.NET.Sdk">

    <!-- Engine tests (every conversion, every detailed setting) and window tests that render the
         real UI off-screen. Runs on Windows and Linux; like the app, each run uses its own platform project. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>FileConverter.Tests</RootNamespace>
        <BuiltInComInteropSupport Condition="'$(FcTargetOS)' == 'windows'">true</BuiltInComInteropSupport>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
        <ProjectReference Include="..\FileConverter\FileConverter.csproj" />
    </ItemGroup>

    <!-- read by a test: the file types the Windows installer registers have to be the ones the app reads -->
    <ItemGroup>
        <None Include="../build/windows/installer.iss" Link="installer.iss" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
            <_Parameter1>$(FcTargetOS)</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
