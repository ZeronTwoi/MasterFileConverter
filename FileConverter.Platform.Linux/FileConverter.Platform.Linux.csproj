<Project Sdk="Microsoft.NET.Sdk">

    <!-- Everything that only exists on Linux: XDG folders, /sys and /proc probing, the desktop's
         file manager, the Linux builds of FFmpeg/7-Zip/PDFium. Referenced by the app only when
         building for Linux. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>FileConverter.Platform</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\FileConverter.Core\FileConverter.Core.csproj" />
        <PackageReference Include="bblanchon.PDFium.Linux" Version="157.0.8086" />
    </ItemGroup>

</Project>
